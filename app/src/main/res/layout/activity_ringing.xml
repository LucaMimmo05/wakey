<?xml version="1.0" encoding="utf-8"?>
<!-- Squillo in stile Samsung: nero, orario grande e sottile, bottone rotondo in basso -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="72dp"
    android:paddingBottom="56dp">

    <TextView
        android:id="@+id/ringing_greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="#CCFFFFFF" />

    <TextView
        android:id="@+id/ringing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.Wakey.Hero"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/ringing_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="#99FFFFFF" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp">

        <View
            android:id="@+id/ringing_pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dismiss_pulse" />

        <ImageButton
            android:id="@+id/button_dismiss"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dismiss_button"
            android:contentDescription="@string/dismiss"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dismiss"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@android:color/white" />

</LinearLayout>
