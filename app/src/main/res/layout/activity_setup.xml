<?xml version="1.0" encoding="utf-8"?>
<!-- Guida per far suonare la sveglia anche a telefono bloccato da ore (stile One UI) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingTop="72dp"
                android:text="@string/setup_title"
                android:textAppearance="@style/TextAppearance.Wakey.Header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="40dp"
                android:text="@string/setup_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Wakey.GroupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Le righe dei passaggi vengono aggiunte dal codice -->
                <LinearLayout
                    android:id="@+id/setup_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_done"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/setup_done"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

</LinearLayout>
