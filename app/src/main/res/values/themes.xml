<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema in stile One UI: font di sistema (SamsungOne sui Samsung), colori sobri -->
    <style name="Theme.Sveglia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@color/ui_on_accent</item>
        <item name="colorPrimaryContainer">@color/ui_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/ui_on_accent_container</item>
        <item name="colorSecondary">@color/ui_accent</item>
        <item name="colorOnSecondary">@color/ui_on_accent</item>
        <item name="colorSecondaryContainer">@color/ui_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/ui_on_accent_container</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="colorOnBackground">@color/ui_text</item>
        <item name="colorSurface">@color/ui_background</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorSurfaceVariant">@color/ui_day_off</item>
        <item name="colorOnSurfaceVariant">@color/ui_text_secondary</item>
        <item name="colorSurfaceContainer">@color/ui_card</item>
        <item name="colorSurfaceContainerHigh">@color/ui_card</item>
        <item name="colorSurfaceContainerLow">@color/ui_card</item>
        <item name="colorOutline">@color/ui_text_secondary</item>
        <item name="colorOutlineVariant">@color/ui_divider</item>
        <item name="colorError">@color/ui_error</item>

        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Wakey.Large</item>

        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
    </style>

    <!-- Schermata di squillo: sempre scura, come le sveglie Samsung -->
    <style name="Theme.Sveglia.Ringing">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="ShapeAppearance.Wakey.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">26dp</item>
    </style>

    <!-- Gruppo arrotondato di righe, come le liste di One UI -->
    <style name="Widget.Wakey.GroupCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ui_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Wakey.Large</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Giorno della settimana nell'editor: cerchio pieno quando attivo -->
    <style name="Widget.Wakey.DayToggle" parent="">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_day_toggle</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Testi -->
    <style name="TextAppearance.Wakey.Header" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">30sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.Wakey.RowTime" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">38sp</item>
    </style>

    <style name="TextAppearance.Wakey.Hero" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">96sp</item>
    </style>

    <style name="TextAppearance.Wakey.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
