<?xml version="1.0" encoding="utf-8"?>
<!-- Cerchio di selezione delle righe: vuoto, oppure blu pieno con la spunta -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/ui_accent" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:drawable="@drawable/ic_check"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/ui_text_secondary" />
        </shape>
    </item>
</selector>
